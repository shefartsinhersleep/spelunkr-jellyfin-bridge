# Use with: node --env-file=.env bridge.cjs
HOST=127.0.0.1
PORT=8097
PUBLIC_URL=http://127.0.0.1:8097
# For Jellyfin on another machine, set HOST to a chosen LAN interface
# and PUBLIC_URL to this bridge's address as reachable from Jellyfin.
# This file contains examples only. Keep your real .env out of Git.
